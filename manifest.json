{
  "manifest_version": 3,
  "name": "Odyssey — habits, sprints & focus",
  "description": "Habits, a personal sprint board and a procrastination-aware focus timer. Your data stays on this computer.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Odyssey check-in",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html#settings",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ]
}
